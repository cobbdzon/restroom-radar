# Docker Compose reads this file for variable substitution in compose.yaml.
# Copy to `.env` (gitignored) and adjust.

# Published port for the client container on the host (default 8080).
CLIENT_PORT=8080

# Canonical origin baked into the client build as the Open Graph og:url tag.
# Leave empty to omit the tag from index.html. Needs a rebuild to take effect:
#
#   docker compose up --build
#
# Example: VITE_SITE_URL=https://restroom-radar.example.com
VITE_SITE_URL=